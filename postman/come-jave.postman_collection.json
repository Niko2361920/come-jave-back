{
  "info": {
    "name": "Come Jave API",
    "description": "Colección para probar la API de Come Jave.\n\nCon AUTH_ENABLED=false (desarrollo) no necesitas token: la colección manda los headers x-dev-email / x-dev-admin. Con Firebase real, pega un ID token en la variable `idToken`.\n\nOrden recomendado: carpetas 0 a 3 (los scripts guardan userId, productId y orderId). Antes corre `npm run seed` para tener el menú.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sin token (AUTH_ENABLED=false) se simula un usuario con headers de desarrollo.",
          "if (!pm.collectionVariables.get('idToken')) {",
          "  if (!pm.request.headers.has('x-dev-email')) pm.request.headers.add({ key: 'x-dev-email', value: pm.collectionVariables.get('devEmail') });",
          "  if (!pm.request.headers.has('x-dev-admin')) pm.request.headers.add({ key: 'x-dev-admin', value: 'false' });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "idToken",
      "value": "",
      "description": "ID token de Firebase. Déjalo vacío si el backend corre con AUTH_ENABLED=false."
    },
    {
      "key": "devEmail",
      "value": "ana@javerianacali.edu.co"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "demoProductId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "nequiOrderId",
      "value": ""
    }
  ],
  "item": [
    {
