VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=come-jave.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=come-jave
VITE_FIREBASE_STORAGE_BUCKET=come-jave.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
