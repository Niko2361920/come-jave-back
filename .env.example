# Copia este archivo a .env. Ver README (sección 5) para el detalle de cada variable.
PORT=3000

# Base de datos: sqlite (por defecto) o postgres
DB_TYPE=sqlite
DB_DATABASE=data/app.sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# En producción DB_SYNCHRONIZE debe ser false (se usan migraciones)
# DB_SYNCHRONIZE=true

# Autenticación (Firebase). Con AUTH_ENABLED=false la API acepta todo: solo desarrollo.
AUTH_ENABLED=false
# FIREBASE_PROJECT_ID=come-jave
ALLOWED_EMAIL_DOMAIN=javerianacali.edu.co
# Correos admin, separados por coma
ADMIN_EMAILS=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SWAGGER_ENABLED=true
